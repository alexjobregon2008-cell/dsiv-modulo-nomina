	FERIADOS o|--o{ ASISTENCIAS : afecta
	ASISTENCIAS ||--o{ ASISTENCIAHORAS : detalla
	NOMINAS ||--o{ NOMINADETALLE : contiene
	EMPLEADOS ||--o{ NOMINADETALLE : recibe
	NOMINADETALLE ||--o{ NOMINACONCEPTO : desglosa
	CONCEPTOSNOMINA ||--o{ NOMINACONCEPTO : aplica

	USUARIOS {
		int UsuarioID PK
		nvarchar NombreUsuario UK
		nvarchar ContrasenaHash
		nvarchar Correo UK
		nvarchar Rol
		bit Activo
		tinyint IntentosFallidos
		datetime2 UltimoIntentoFallido
		bit DebeCambiarContrasena
		datetime2 FechaCreacion
	}
	BITACORA {
		int BitacoraID PK
		int UsuarioID FK
		nvarchar Accion
		nvarchar Descripcion
		sysname TablaAfectada
		int RegistroID
		datetime2 FechaHora
	}
	DEPARTAMENTOS {
		int DepartamentoID PK
		nvarchar Nombre UK
		nvarchar Descripcion
		bit Activo
	}
	CARGOS {
		int CargoID PK
		int DepartamentoID FK
		nvarchar Nombre
		nvarchar Descripcion
		decimal SalarioMinimo
		decimal SalarioMaximo
		bit Activo
	}
	EMPLEADOS {
		int EmpleadoID PK
		nvarchar Nombre UK
		int DepartamentoID FK
		int CargoID FK
		decimal SalarioBase
		nvarchar TipoContrato
		bit AplicaDescuentos
		date FechaInicioContrato
		bit Activo
		datetime2 FechaCreacion
	}
	TURNOS {
		int TurnoID PK
		nvarchar Nombre UK
		time HoraInicio
		time HoraFin
		nvarchar TipoJornada
		decimal HorasProgramadas
		bit Activo
	}
	EMPLEADOTURNO {
		int EmpleadoTurnoID PK
		int EmpleadoID FK
		int TurnoID FK
		date FechaDesde
		date FechaHasta
		bit Activo
	}
	FERIADOS {
		int FeriadoID PK
		date Fecha UK
		nvarchar Nombre
		nvarchar TipoFeriado
		bit EsDiaNoLaborable
		bit Activo
	}
	ASISTENCIAS {
		int AsistenciaID PK
		int EmpleadoID FK
		int TurnoID FK
		date Fecha
		time HoraEntrada
		time HoraSalida
		nvarchar TipoRegistro
		nvarchar Estado
		decimal HorasProgramadas
		decimal HorasTrabajadas
		decimal HorasNormales
		bit EsDomingo
		bit EsFeriado
		int FeriadoID FK
		bit Justificada
		bit GeneraDescuento
		nvarchar Observacion
	}
	ASISTENCIAHORAS {
		int AsistenciaHoraID PK
		int AsistenciaID FK
		nvarchar TipoHora
		decimal CantidadHoras
		bit HorasAprobadas
		int AprobadoPorUsuarioID FK
		datetime2 FechaAprobacion
	}
	NOMINAS {
		int NominaID PK
		date FechaPago
		date PeriodoDesde
		date PeriodoHasta
		nvarchar PeriodoPagado
		nvarchar Estado
		decimal TotalBruto
		decimal TotalDeducciones
		decimal TotalAportesPatronales
		decimal TotalNeto
		datetime2 FechaCreacion
	}
	NOMINADETALLE {
		int NominaDetalleID PK
		int NominaID FK
		int EmpleadoID FK
		decimal SalarioBase
		decimal TotalDevengado
		decimal TotalDeducciones
		decimal TotalAportesPatronales
		decimal SalarioNeto
	}
	CONCEPTOSNOMINA {
		int ConceptoID PK
		varchar Codigo UK
		nvarchar Nombre
		nvarchar TipoConcepto
		nvarchar Naturaleza
		nvarchar AplicaA
		bit Activo
	}
	REGLASNOMINAPANAMA {
		int ReglaID PK
		int ConceptoID FK
		varchar CodigoRegla
		nvarchar Descripcion
		nvarchar TipoCalculo
		decimal Porcentaje
		decimal Multiplicador
		decimal MontoDesde
		decimal MontoHasta
		decimal Valor
		nvarchar Periodicidad
		date VigenciaDesde
		date VigenciaHasta
		nvarchar FuenteLegal
		bit Activo
	}
	NOMINACONCEPTO {
		int NominaConceptoID PK
		int NominaDetalleID FK
		int ConceptoID FK
		int AsistenciaID FK
		int AsistenciaHoraID FK
		decimal BaseCalculo
		decimal Cantidad
		decimal PorcentajeAplicado
		decimal Monto
		bit EsPatronal
		nvarchar Descripcion
	}

